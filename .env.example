APP_NAME=BSWebSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password hashing = Argon2id + global pepper (design.md §29). Generate a strong
# random value per environment; NEVER commit the real secret. Rotate by moving the
# old value into AUTH_PASSWORD_PEPPER_PREVIOUS (comma-separated).
AUTH_PASSWORD_PEPPER=
AUTH_PASSWORD_PEPPER_PREVIOUS=
# ARGON_MEMORY=65536
# ARGON_TIME=4
# ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 via PgBouncer (transaction mode). App → pgbouncer:6432 → postgres:5432
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=bswebsaas
DB_USERNAME=app_user
DB_PASSWORD=app_secret

# Gate #1: privileged DDL/migration role — DIRECT to Postgres (bypasses PgBouncer).
# Migrate with: php artisan migrate --database=pgsql_admin
DB_ADMIN_HOST=postgres
DB_ADMIN_PORT=5432
DB_ADMIN_USERNAME=bsweb
DB_ADMIN_PASSWORD=secret

# Octane
OCTANE_SERVER=frankenphp

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey (Redis-protocol compatible) — NOT Redis
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Admin plane (tenant /admin) + Platform operator console ──────────────────────
# Dedicated key for encrypting stored settings secrets (SMTP / OAuth creds), SEPARATE
# from APP_KEY — AES-256-GCM via SecretCipher. REQUIRED: the settings/secret pages throw
# without it. Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
SETTINGS_ENCRYPTION_KEY=

# Host of the platform operator console (no tenant context). Plane routing + isolation
# depend on this; set it to the real operator domain in production.
PLATFORM_HOST=platform.bswebsaas.test

# URL-prefix for the tenant admin plane (route NAMES stay admin.* regardless).
ADMIN_PREFIX=admin

# The ONE canonical OAuth2 redirect URI registered with every provider. Leave blank to
# default to https://${PLATFORM_HOST}/oauth/callback.
OAUTH_CALLBACK_URL=

# Admin chrome branding (white-label).
ADMIN_BRAND_NAME="Bảo Sơn"
ADMIN_BRAND_TAGLINE="Giúp bạn thành công"
ADMIN_BRAND_COMPANY="BaoSon Ads"
ADMIN_BRAND_URL=https://baoson.net

# Genesis platform super_admin — seeded as the FIRST account. Leave the password blank in
# production: a random one is generated and the operator claims it via password-reset.
SUPER_ADMIN_EMAIL=admin@baoson.net
SUPER_ADMIN_NAME="Bảo Sơn Operator"
SUPER_ADMIN_PASSWORD=

# ── Cloudflare R2 (media storage; S3-compatible 'r2' disk) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto

# ── Media URL resolver (ADR-17): driver = cloudflare | imgproxy | static ──
MEDIA_DRIVER=cloudflare
MEDIA_CF_BASE=https://files.baoson.net
MEDIA_IMGPROXY_BASE=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_SOURCE_BUCKET=s3://bswebsaas-media
