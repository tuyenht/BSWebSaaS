APP_NAME=BSWebSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password hashing = Argon2id + global pepper (design.md §29). Generate a strong
# random value per environment; NEVER commit the real secret. Rotate by moving the
# old value into AUTH_PASSWORD_PEPPER_PREVIOUS (comma-separated).
AUTH_PASSWORD_PEPPER=
AUTH_PASSWORD_PEPPER_PREVIOUS=
# ARGON_MEMORY=65536
# ARGON_TIME=4
# ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 via PgBouncer (transaction mode). App → pgbouncer:6432 → postgres:5432
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=bswebsaas
DB_USERNAME=app_user
DB_PASSWORD=app_secret

# Gate #1: privileged DDL/migration role — DIRECT to Postgres (bypasses PgBouncer).
# Migrate with: php artisan migrate --database=pgsql_admin
DB_ADMIN_HOST=postgres
DB_ADMIN_PORT=5432
DB_ADMIN_USERNAME=bsweb
DB_ADMIN_PASSWORD=secret

# Octane
OCTANE_SERVER=frankenphp

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey (Redis-protocol compatible) — NOT Redis
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production error notices (config/monitoring.php). Empty MONITORING_MAIL_TO = off.
# The MONITORING_MAIL_* sender is the platform's own mail account, separate from MAIL_*.
MONITORING_MAIL_TO=
MONITORING_MAIL_HOST=
MONITORING_MAIL_PORT=
MONITORING_MAIL_SCHEME=
MONITORING_MAIL_USERNAME=
MONITORING_MAIL_PASSWORD=
MONITORING_MAIL_FROM_ADDRESS=
MONITORING_MAIL_FROM_NAME=
# A bare GET every 5 minutes proves the scheduler is alive. Empty = no heartbeat.
MONITORING_HEARTBEAT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Admin plane (tenant /admin) + Platform operator console ──────────────────────
# Dedicated key for encrypting stored settings secrets (SMTP / OAuth creds), SEPARATE
# from APP_KEY — AES-256-GCM via SecretCipher. REQUIRED: the settings/secret pages throw
# without it. Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
SETTINGS_ENCRYPTION_KEY=

# Host of the platform operator console (no tenant context). Plane routing + isolation
# depend on this; set it to the real operator domain in production.
PLATFORM_HOST=platform.bswebsaas.test

# true = a site still on its platform subdomain asks search engines not to index it.
# Turn on once customers' sites have their own domains; customers' domains are never affected.
NOINDEX_PLATFORM_SUBDOMAINS=false

# The ONE host customers point their own domain at (design.md §28). Blank = PLATFORM_HOST.
# It must stay DNS-only and resolve to the web server.
CUSTOM_DOMAIN_TARGET=
# DNS label of the TXT record that settles a contested domain ({label}.{domain}).
CUSTOM_DOMAIN_TXT_LABEL=_site-verification
# host:port of the web server for the first HTTPS request of a customer's domain (e.g. caddy:443),
# when the server cannot reach its own public address from inside. Blank = the public address.
CUSTOM_DOMAIN_TLS_ENDPOINT=
# Public IPv4 that a customer's root-domain A record must use; it must be an address CUSTOM_DOMAIN_TARGET
# resolves to. Blank = the "point by number" option says it is not available.
CUSTOM_DOMAIN_IP=
# Seconds one run of domains:recheck-waiting (every 15 minutes) may spend on DNS checks.
CUSTOM_DOMAIN_RECHECK_BUDGET=600

# URL-prefix for the tenant admin plane (route NAMES stay admin.* regardless).
ADMIN_PREFIX=admin

# The ONE canonical OAuth2 redirect URI registered with every provider. Leave blank to
# default to https://${PLATFORM_HOST}/oauth/callback.
OAUTH_CALLBACK_URL=

# Admin chrome branding (white-label).
ADMIN_BRAND_NAME="Bảo Sơn"
ADMIN_BRAND_TAGLINE="Giúp bạn thành công"
ADMIN_BRAND_COMPANY="BaoSon Ads"
ADMIN_BRAND_URL=https://baoson.net
# Admin brand colour: a key of resources/admin-brands.json (bao-son, navy, blue, cyan, teal,
# green, indigo, violet, plum). Unknown or blank = bao-son.
ADMIN_BRAND_COLOR=bao-son

# Genesis platform super_admin — seeded as the FIRST account. Leave the password blank in
# production: a random one is generated and the operator claims it via password-reset.
SUPER_ADMIN_EMAIL=admin@baoson.net
SUPER_ADMIN_NAME="Bảo Sơn Operator"
SUPER_ADMIN_PASSWORD=

# ── Cloudflare R2 (media storage; S3-compatible 'r2' disk) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
# Cloudflare API token (cf.image derivative purge / R2 management).
CLOUDFLARE_API_TOKEN=

# ── Media storage layout (config/media.php) ──
# disk: r2 (multi-tenant SaaS) | local (standalone export). url_hash_length: cache-bust suffix (0 = clean, default 4).
MEDIA_DISK=r2
MEDIA_TENANT_PREFIX=true
MEDIA_URL_HASH_LENGTH=4

# ── Media URL resolver (ADR-17): driver = cloudflare | imgproxy | static ──
MEDIA_DRIVER=cloudflare
MEDIA_CF_BASE=https://files.baoson.net
MEDIA_IMGPROXY_BASE=
IMGPROXY_KEY=
IMGPROXY_SALT=
MEDIA_SOURCE_BUCKET=s3://baoson-media

# NOTE: environment-SPECIFIC keys are deliberately NOT listed here (env:check shows them as
# harmless "extra"): COMPOSE_FILE (Docker infra — a blank value breaks `docker compose`),
# TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY, BASE_DOMAINS / PRIMARY_BASE, SESSION_SECURE_COOKIE.
# site:provision only starts a site on {slug}.{a platform base}: to provision a local dev site on
# e.g. shop.platform.test, set BASE_DOMAINS=baoson.net,platform.test (Pest and the hammer set their own).
# Optional, also not listed: TENANCY_RESERVED_LABELS — extra labels (comma-separated) a new site may
# never start on under a platform base, on top of the defaults in config/tenancy.php (admin, api,
# mail, sgtm…); it only ADDS, never removes one.
# .env.example holds only keys that are SAFE to copy into any .env.
