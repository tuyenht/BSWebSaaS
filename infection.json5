{
    // Mutation testing (CLAUDE.md §6). Run locally / on PRs:
    //   docker compose run --rm --no-deps app vendor/bin/infection --threads=max
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app"]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "storage/logs/infection.log"
    }
}
