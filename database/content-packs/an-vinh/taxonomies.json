   ],
   "layout_blocks": {
    "after_list": {
     "vi": {
      "blocks": [
       {
        "type": "process",
        "props": {
         "heading": "Quy Trình Làm Việc",
         "description": "Sáu bước rõ ràng giúp khách hàng luôn nắm được tiến độ đơn hàng.",
         "bg": "tint",
         "steps": [
          {
           "title": "Tiếp nhận yêu cầu",
           "text": "Nhận bản vẽ 2D/3D, mẫu thật hoặc ý tưởng. Ký thoả thuận bảo mật (NDA) khi cần."
          },
          {
           "title": "Phân tích & báo giá",
           "text": "Đánh giá vật liệu, dung sai, tiến độ và gửi báo giá chi tiết."
          },
          {
           "title": "Thiết kế & lập trình",
           "text": "Thiết kế 3D, mô phỏng, lập trình gia công tối ưu."
          },
          {
           "title": "Gia công & lắp ráp",
           "text": "Phay, tiện, cắt dây, hàn, lắp ráp tại 3 nhà máy."
          },
          {
           "title": "Đo kiểm QA/QC",
           "text": "Kiểm tra kích thước, chức năng; lập biên bản đo kiểm."
          },
          {
           "title": "Bàn giao & hỗ trợ",
           "text": "Giao hàng, hướng dẫn sử dụng, hỗ trợ kỹ thuật sau bàn giao."
          }
         ]
        }
       },
       {
        "type": "cta",
        "props": {
         "variant": "rounded",
         "heading": "Có bản vẽ cần gia công?",
         "text": "Gửi bản vẽ 2D/3D, kỹ sư An Vinh sẽ tư vấn phương án và báo giá.",
         "button_label": "Gửi yêu cầu báo giá",
         "button_url": "/lien-he",
         "extra_style": [
          "pattern-cross"
         ]
        }
       }
