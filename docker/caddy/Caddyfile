{
	email tuyenht@gmail.com
	on_demand_tls {
		ask http://app:80/caddy/ask
	}
	# Cloudflare edges là proxy-ngoài DUY NHẤT được tin (host chạy qua "đám mây cam"). CHỈ khi peer
	# thuộc dải CF thì Caddy mới lấy IP khách thật từ CF-Connecting-IP để dựng {client_ip}; request
	# đấm thẳng origin (peer KHÔNG thuộc dải CF — vd av1 "đám mây xám", hay kẻ né CF) không khớp →
	# Caddy dùng remote thật của nó, nên header CF-Connecting-IP giả KHÔNG lừa được. Dải lấy từ
	# https://www.cloudflare.com/ips/ (rà lại định kỳ — CF đổi rất hiếm).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

# Thời hạn lưu đệm cho tệp tĩnh của app (app không gửi Cache-Control cho các tệp này).
# Tên tệp do Vite dựng có mã băm nội dung: đổi nội dung là đổi tên, nên giữ một năm là an toàn.
# Tệp font giữ nguyên tên qua các bản: một tháng rồi hỏi lại máy chủ (có ETag).
(static_cache) {
	# Chỉ gắn cho câu trả lời 200: một 404 (tệp chưa có) không bị trình duyệt hay Cloudflare giữ lại.
	@hashed path /build/assets/*
	header @hashed {
		match status 200
		Cache-Control "public, max-age=31536000, immutable"
	}
	@fonts path /fonts/*
	header @fonts {
		match status 200
		Cache-Control "public, max-age=2592000"
	}
	# Biểu tượng tab: một ngày (tên không đổi khi thay).
	@favicon path /favicon.ico
	header @favicon {
		match status 200
		Cache-Control "public, max-age=86400"
	}
	# Không báo phiên bản PHP ra ngoài.
	header -X-Powered-By
}

# Platform console — cert MANAGED riêng, KHÔNG phụ thuộc ask-endpoint (fail-safe).
website.baoson.net {
	encode zstd gzip
	import static_cache
	# Đẩy IP khách THẬT (Caddy đã giải qua trusted_proxies + CF-Connecting-IP) xuống app trong
	# X-Forwarded-For. App tin Caddy (dải private) → request()->ip() ra đúng khách sau Cloudflare;
	# host xám thì {client_ip} = remote trực tiếp = khách thật → cùng một đường, không rẽ nhánh.
	reverse_proxy app:80 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Tenant subdomain + custom domain — cert on demand, gated bởi /caddy/ask (domains table).
:443 {
	tls {
		on_demand
	}
	encode zstd gzip
	import static_cache
	reverse_proxy app:80 {
		header_up X-Forwarded-For {client_ip}
	}
}

# ── Velzon reference demos (nội bộ, KHÔNG phải production) ──────────────────
# DNS 2 sub này đang orange-cloud (proxy Cloudflare). Origin phục vụ CẢ hai:
#   - HTTP :80  → khớp CF SSL mode Flexible + tool nội bộ truy cập thẳng
#   - HTTPS tls internal (self-signed) → khớp CF SSL mode Full
# KHÔNG redirect http→https ở origin: CF mode Flexible sẽ bị redirect-loop.
http://default.baoson.net {
	encode zstd gzip
	reverse_proxy velzon-default:80
}

http://master.baoson.net {
	encode zstd gzip
	reverse_proxy velzon-master:80
}

default.baoson.net {
	tls internal
	encode zstd gzip
	reverse_proxy velzon-default:80
}

master.baoson.net {
	tls internal
	encode zstd gzip
	reverse_proxy velzon-master:80
}
